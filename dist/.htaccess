DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddType text/javascript .mjs
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://sight.ieeekerala.org%{REQUEST_URI} [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
</IfModule>

# Revalidate documents and code so visitors receive published corrections.
<IfModule mod_headers.c>
<FilesMatch "\.(html|css|mjs|js|xml|txt|webmanifest)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(png|jpe?g|webp|svg|ico|ttf|woff2?)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
